# Robinhood Meme Sniper configuration
# Paper mode is the default and does not send real transactions.

# Execution mode: paper uses live quotes without sending transactions; live uses real funds.
MODE=paper

# Required only for live trading: set to I_UNDERSTAND. Leave blank for paper mode.
LIVE_TRADING_ACK=

# Your wallet private key: 0x followed by 64 hexadecimal characters. Keep this value private.
PRIVATE_KEY=0x

# Robinhood mainnet HTTP(S) RPC endpoint (chain ID 4663). Replace with your provider URL for sustained operation.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# GoPlus Console App Key. Set together with App Secret to enable automatic token renewal.
GOPLUS_APP_KEY=9s0SPaezQWp23KWj49Ya

# GoPlus Console App Secret. Keep private; used locally to sign access-token requests.
GOPLUS_APP_SECRET=eGmmFQgK1mS2DX9mAw35dHnNTKcWHqdX

# Optional manual access token. Ignored when App Key and App Secret are set. Manual tokens are not automatically renewed.
GOPLUS_API_TOKEN=

# Uniswap V2 Factory to monitor for PairCreated events. Verify any replacement against official deployments.
FACTORY_ADDRESS=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f

# Uniswap V2 Router02 used for quotes and swaps. Must match the configured Factory and WETH.
ROUTER_ADDRESS=0x89e5db8b5aa49aa85ac63f691524311aeb649eba

# Wrapped ETH contract on Robinhood mainnet. Only direct WETH pairs are supported.
WETH_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73

# Native ETH spent per entry, excluding gas.
BUY_ETH=0.001

# Maximum entry principal per UTC day. Excludes gas; selling does not replenish this allowance.
MAX_DAILY_BUY_ETH=0.01

# Minimum WETH reserve on the WETH side of a candidate pool, in ETH units.
MIN_LIQUIDITY_ETH=5

# Maximum number of simultaneously tracked positions.
MAX_POSITIONS=3

# Quote slippage allowance in basis points: 100 bps = 1%.
SLIPPAGE_BPS=100

# Maximum buy amount / WETH reserve ratio, in basis points; a conservative pool-size guard.
MAX_PRICE_IMPACT_BPS=100

# Maximum gas price for each live transaction, in gwei.
MAX_GAS_GWEI=2

# Maximum estimated fee per transaction, including approvals, in ETH.
MAX_TX_FEE_ETH=0.0005

# Minimum ETH left after estimated transaction value and fees. Applies to buys, approvals, and sells.
GAS_RESERVE_ETH=0.003

# Exit when the sell quote after slippage reaches this gain over entry principal. 5000 = +50%; excludes gas.
TAKE_PROFIT_BPS=5000

# Exit when the sell quote after slippage reaches this loss from entry principal. 2000 = -20%; execution is not guaranteed.
STOP_LOSS_BPS=2000

# Exit after this holding duration, if a valid sell quote and execution are available.
MAX_HOLD_SECONDS=3600

# Maximum reported holding per address, excluding the current pair and burn addresses. 1000 = 10%.
MAX_HOLDER_BPS=1000

# Minimum LP supply held by zero/dead burn addresses. 9500 = 95%; time-locked LP does not count.
MIN_BURNED_LP_BPS=9500

# Delay after each completed loop, in milliseconds. API calls and transaction confirmations add extra latency.
POLL_MS=3000

# Block confirmation depth for discovery and transaction receipts; not Ethereum finality.
CONFIRMATIONS=3

# Maximum number of blocks scanned in one discovery iteration.
BLOCK_CHUNK=100

# Initial lookback when no saved cursor exists. Existing state resumes from its saved cursor.
LOOKBACK_BLOCKS=100

# Candidate lifetime measured from the pair creation block timestamp.
CANDIDATE_TTL_SECONDS=600

# Candidate queue capacity. New candidates are dropped and logged when the queue is full.
MAX_CANDIDATES=200

# State directory relative to the project root, or an absolute path. Paper and live use separate files.
DATA_DIR=data

# Console output: auto = live dashboard in a terminal, JSON when redirected. Alternatives: pretty or json.
LOG_FORMAT=auto
